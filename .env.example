# AI 서버 설정
# 로컬 무료 서버 사용 (추천)
USE_LOCAL_SERVER=true
FREE_CLAUDE_CODE_URL=http://localhost:8082
ANTHROPIC_AUTH_TOKEN=freecc

# 외부 유료 API 사용 시
# USE_LOCAL_SERVER=false
# EXTERNAL_AI_URL=https://api.anthropic.com
# EXTERNAL_AI_KEY=sk-ant-api03-your-key-here

# 네이버 블로그
NAVER_ID=your_naver_id
NAVER_PASSWORD=your_naver_password
NAVER_BLOG_ID=your_blog_address_id

# 티스토리
TISTORY_ID=your_tistory_id
TISTORY_PASSWORD=your_tistory_password
TISTORY_BLOG_NAME=your_blog_name

# 워드프레스
WORDPRESS_URL=https://your-site.wordpress.com
WORDPRESS_USERNAME=your_username
WORDPRESS_PASSWORD=your_password

# GitLab
GITLAB_REPO_URL=your_gitlab_repo_url

# 기타 설정
DEFAULT_AI_MODEL=claude-sonnet-4-20250514
BROWSER_HEADLESS=false
